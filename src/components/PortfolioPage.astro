---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Copy } from '../data/portfolio';
interface Props { copy: Copy }
const { copy } = Astro.props;
const isFa = copy.locale === 'fa';
const title = isFa ? 'سید محمد امین عمرانی | مهندس نرم‌افزار فول‌استک' : 'Sayed Mohammad Amin Emrani | Full-stack Software Engineer';
const description = isFa ? 'پورتفولیوی سید محمد امین عمرانی؛ مهندس نرم‌افزار فول‌استک، توسعه‌دهنده Go، Next.js و Flutter و سازنده محصولات SaaS و IoT.' : 'Portfolio of Sayed Mohammad Amin Emrani, a full-stack engineer building SaaS, mobile, backend, DevOps, and IoT products.';
const canonical = isFa ? 'https://smae1993.github.io/' : 'https://smae1993.github.io/en/';
const alternate = isFa ? 'https://smae1993.github.io/en/' : 'https://smae1993.github.io/';
const icons: Record<string, string> = {
  product: 'M12 3 4 7v10l8 4 8-4V7l-8-4Zm0 0v18M4 7l8 4 8-4',
  architecture: 'M4 19h16M6 16V8m6 8V4m6 12v-6M4 8h4m2-4h4m2 6h4',
  production: 'M12 3a9 9 0 1 0 9 9M12 7v5l3 2M16 3h5v5',
};
---
<BaseLayout lang={copy.locale} dir={copy.dir} title={title} description={description} canonical={canonical} alternate={alternate}>
  <header class="site-header" data-header>
    <div class="container header-inner">
      <a class="brand" href={isFa ? '/' : '/en/'} aria-label={copy.hero.name}>
        <span class="brand-mark">A</span><span class="brand-text">AMIN<span class="brand-dot">.</span></span>
      </a>
      <nav class="desktop-nav" aria-label={isFa ? 'ناوبری اصلی' : 'Primary navigation'}>
        {copy.nav.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
      <div class="header-actions">
        <a class="language-switch" href={copy.alternateHref}>{copy.languageName}</a>
        <button class="icon-button command-button" type="button" data-command-trigger aria-label={isFa ? 'منوی سریع' : 'Quick menu'}>⌘K</button>
        <button class="icon-button theme-toggle" type="button" data-theme-toggle aria-label={isFa ? 'تغییر پوسته' : 'Toggle theme'}>
          <svg class="sun" viewBox="0 0 24 24"><path d="M12 3v2m0 14v2M3 12h2m14 0h2M5.6 5.6 7 7m10 10 1.4 1.4M18.4 5.6 17 7M7 17l-1.4 1.4"/><circle cx="12" cy="12" r="4"/></svg>
          <svg class="moon" viewBox="0 0 24 24"><path d="M20 15.5A8.5 8.5 0 0 1 8.5 4 8.5 8.5 0 1 0 20 15.5Z"/></svg>
        </button>
      </div>
    </div>
  </header>

  <main id="main">
    <section class="hero section" id="home">
      <div class="container hero-grid">
        <div class="hero-copy reveal">
          <div class="availability"><span></span>{copy.hero.availability}</div>
          <p class="eyebrow">{copy.hero.eyebrow}</p>
          <h1><small>{copy.hero.name}</small>{copy.hero.title}</h1>
          <p class="hero-lead">{copy.hero.lead}</p>
          <div class="hero-actions">
            <a class="button button-primary" href="#projects">{copy.hero.primary}<svg viewBox="0 0 24 24"><path d={isFa ? 'm8 5-7 7 7 7M1 12h22' : 'm16 5 7 7-7 7M23 12H1'} /></svg></a>
            <span class="button button-ghost disabled">{copy.hero.secondary}</span>
          </div>
          <div class="hero-meta" dir="ltr"><span>Kerman · Iran</span><i></i><span>UTC +03:30</span><i></i><span>Remote friendly</span></div>
        </div>
        <div class="hero-visual reveal" data-tilt>
          <div class="orbit orbit-one"></div><div class="orbit orbit-two"></div>
          <div class="terminal-card">
            <div class="terminal-header"><div class="window-controls"><i></i><i></i><i></i></div><span>{copy.hero.terminalTitle}</span><b>● LIVE</b></div>
            <div class="terminal-body" dir="ltr">
              {copy.hero.terminalLines.map((line, index) => <div class:list={['terminal-line', { command: line.startsWith('$') }]} style={`--delay:${index * 100}ms`}>{line}</div>)}
              <div class="terminal-cursor"></div>
            </div>
            <div class="code-map" aria-hidden="true"><span style="--x:9%;--y:18%;--s:1.1">GO</span><span style="--x:64%;--y:16%;--s:.85">NEXT</span><span style="--x:22%;--y:71%;--s:.75">MQTT</span><span style="--x:67%;--y:70%;--s:1">FLUTTER</span><span style="--x:43%;--y:43%;--s:1.4">{'{ }'}</span></div>
          </div>
        </div>
      </div>
      <div class="container metric-grid reveal">{copy.metrics.map((metric) => <div class="metric"><strong>{metric.value}</strong><span>{metric.label}</span></div>)}</div>
    </section>

    <section class="section" id="about">
      <div class="container">
        <div class="section-heading reveal"><p class="eyebrow">{copy.about.eyebrow}</p><h2>{copy.about.title}</h2></div>
        <div class="about-grid">
          <div class="about-copy reveal">{copy.about.body.map((p) => <p>{p}</p>)}<div class="signature" dir="ltr"><span>S. M. Amin Emrani</span><small>Engineer · Builder · Problem Solver</small></div></div>
          <div class="about-cards">{copy.about.cards.map((card, index) => <article class="principle-card reveal" style={`--i:${index}`}><div class="principle-icon"><svg viewBox="0 0 24 24"><path d={icons[card.icon]} /></svg></div><div><h3>{card.title}</h3><p>{card.text}</p></div></article>)}</div>
        </div>
      </div>
    </section>

    <section class="section projects-section" id="projects">
      <div class="container">
        <div class="section-heading split-heading reveal"><div><p class="eyebrow">{copy.projects.eyebrow}</p><h2>{copy.projects.title}</h2></div><p>{copy.projects.intro}</p></div>
        <div class="projects-grid">
          {copy.projects.items.map((project, index) => <article class:list={['project-card', 'reveal', { featured: project.featured }]} style={`--accent:${project.accent};--i:${index}`}>
            <div class="project-topline"><span>{project.kicker}</span><span>{project.status}</span></div>
            <div class="project-monogram"><b>{project.name.slice(0, 1)}</b><i></i><i></i><i></i></div>
            <h3>{project.name}</h3><p>{project.description}</p>
            <div class="tag-list">{project.stack.map((tech) => <span>{tech}</span>)}</div>
            <div class="project-footer">{project.href ? <a href={project.href} target="_blank" rel="noreferrer">{copy.projects.visitLabel} ↗</a> : <span class="private-label"><svg viewBox="0 0 24 24"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>{copy.projects.privateLabel}</span>}</div>
          </article>)}
        </div>
      </div>
    </section>

    <section class="section" id="stack">
      <div class="container">
        <div class="section-heading split-heading reveal"><div><p class="eyebrow">{copy.stack.eyebrow}</p><h2>{copy.stack.title}</h2></div><p>{copy.stack.intro}</p></div>
        <div class="stack-grid">{copy.stack.groups.map((group, index) => <article class="stack-card reveal" style={`--i:${index}`}><div class="stack-number">0{index + 1}</div><h3>{group.title}</h3><ul>{group.items.map((item) => <li><span></span>{item}</li>)}</ul></article>)}</div>
      </div>
    </section>

    <section class="section process-section">
      <div class="container">
        <div class="section-heading reveal"><p class="eyebrow">{copy.process.eyebrow}</p><h2>{copy.process.title}</h2></div>
        <div class="process-list">{copy.process.steps.map((step) => <article class="process-item reveal"><span>{step.number}</span><h3>{step.title}</h3><p>{step.text}</p><b>↗</b></article>)}</div>
      </div>
    </section>

    <section class="section" id="opensource">
      <div class="container">
        <div class="section-heading split-heading reveal"><div><p class="eyebrow">{copy.openSource.eyebrow}</p><h2>{copy.openSource.title}</h2></div><p>{copy.openSource.intro}</p></div>
        <div class="repo-grid">{copy.openSource.repos.map((repo) => <a class="repo-card reveal" href={repo.href} target="_blank" rel="noreferrer"><div class="repo-icon"><svg viewBox="0 0 24 24"><path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 6v-3.9c0-1.1.1-1.5-.5-2.1 2.8-.3 5.7-1.4 5.7-6.2 0-1.4-.5-2.5-1.3-3.4.1-.3.6-1.6-.1-3.3 0 0-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.3 0C6.6 2.7 5.5 3 5.5 3c-.7 1.7-.2 3-.1 3.3A4.8 4.8 0 0 0 4 9.8c0 4.8 2.9 5.9 5.7 6.2-.5.5-.6 1-.6 2.1V22"/></svg></div><div><div class="repo-title"><h3>{repo.name}</h3><span>↗</span></div><p>{repo.description}</p><small><i></i>{repo.language}</small></div></a>)}</div>
        <div class="center-action reveal"><a class="text-link" href="https://github.com/smae1993?tab=repositories" target="_blank" rel="noreferrer">{copy.openSource.allRepos}<span>↗</span></a></div>
      </div>
    </section>

    <section class="section contact-section" id="contact">
      <div class="container"><div class="contact-card reveal"><div class="contact-orbit"></div><p class="eyebrow">{copy.contact.eyebrow}</p><h2>{copy.contact.title}</h2><p>{copy.contact.text}</p><div class="contact-actions"><a class="button button-light" href="mailto:smae1993@gmail.com">{copy.contact.email}<svg viewBox="0 0 24 24"><path d={isFa ? 'm8 5-7 7 7 7M1 12h22' : 'm16 5 7 7-7 7M23 12H1'} /></svg></a><a class="button button-outline-light" href="https://github.com/smae1993" target="_blank" rel="noreferrer">{copy.contact.github}</a><button class="button button-outline-light" type="button" data-copy-email data-default={copy.contact.copy} data-copied={copy.contact.copied}>{copy.contact.copy}</button></div><a class="contact-email" href="mailto:smae1993@gmail.com" dir="ltr">smae1993@gmail.com</a></div></div>
    </section>
  </main>

  <footer class="site-footer"><div class="container footer-inner"><div><strong>AMIN<span>.</span></strong><p>{copy.footer}</p></div><p>© {new Date().getFullYear()} S. M. Amin Emrani</p></div></footer>

  <dialog class="command-dialog" data-command-dialog><div class="command-panel"><div class="command-search"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg><span>{copy.commands.placeholder}</span><kbd>ESC</kbd></div><div class="command-list">{copy.commands.items.map((item) => <a href={item.href} data-command-link><span>{item.label}</span><kbd>{item.hint}</kbd></a>)}</div><div class="command-footer">↑↓ · {isFa ? 'انتخاب و باز کردن' : 'Navigate and open'} · ↵</div></div></dialog>

  <script is:inline>
    (() => {
      const root = document.documentElement;
      root.dataset.theme = localStorage.getItem('portfolio-theme') || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => { const next = root.dataset.theme === 'dark' ? 'light' : 'dark'; root.dataset.theme = next; localStorage.setItem('portfolio-theme', next); });
      const header = document.querySelector('[data-header]');
      const onScroll = () => header?.classList.toggle('scrolled', scrollY > 24); onScroll(); addEventListener('scroll', onScroll, { passive: true });
      const observer = new IntersectionObserver((entries) => entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add('visible'); observer.unobserve(entry.target); } }), { threshold: .12, rootMargin: '0px 0px -40px' });
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
      const dialog = document.querySelector('[data-command-dialog]');
      const open = () => dialog instanceof HTMLDialogElement && !dialog.open && dialog.showModal();
      const close = () => dialog instanceof HTMLDialogElement && dialog.open && dialog.close();
      document.querySelectorAll('[data-command-trigger]').forEach((b) => b.addEventListener('click', open));
      document.querySelectorAll('[data-command-link]').forEach((l) => l.addEventListener('click', close));
      dialog?.addEventListener('click', (e) => e.target === dialog && close());
      addEventListener('keydown', (e) => { if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); open(); } });
      const copy = document.querySelector('[data-copy-email]');
      copy?.addEventListener('click', async () => { try { await navigator.clipboard.writeText('smae1993@gmail.com'); copy.textContent = copy.dataset.copied || 'Copied'; setTimeout(() => copy.textContent = copy.dataset.default || 'Copy email', 1600); } catch { location.href = 'mailto:smae1993@gmail.com'; } });
      if (matchMedia('(pointer: fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const tilt = document.querySelector('[data-tilt]');
        tilt?.addEventListener('pointermove', (e) => { const r = tilt.getBoundingClientRect(); const x = (e.clientX-r.left)/r.width-.5; const y=(e.clientY-r.top)/r.height-.5; tilt.style.setProperty('--rx', `${-y*7}deg`); tilt.style.setProperty('--ry', `${x*9}deg`); });
        tilt?.addEventListener('pointerleave', () => { tilt.style.setProperty('--rx', '0deg'); tilt.style.setProperty('--ry', '0deg'); });
      }
    })();
  </script>
</BaseLayout>
