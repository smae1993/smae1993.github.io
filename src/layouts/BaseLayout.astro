---
import '../styles/global.css';
import type { Locale } from '../data/portfolio';

interface Props {
  lang: Locale;
  dir: 'rtl' | 'ltr';
  title: string;
  description: string;
  canonical: string;
  alternate: string;
}

const { lang, dir, title, description, canonical, alternate } = Astro.props;
const isFa = lang === 'fa';
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Sayed Mohammad Amin Emrani',
  alternateName: 'سید محمد امین عمرانی',
  url: 'https://smae1993.github.io',
  image: 'https://avatars.githubusercontent.com/u/20657643?v=4',
  email: 'mailto:smae1993@gmail.com',
  jobTitle: 'Full-stack Software Engineer',
  knowsAbout: ['Go', 'Flutter', 'Next.js', 'Astro', 'DevOps', 'IoT', 'System Design'],
  sameAs: ['https://github.com/smae1993'],
};
---
<!doctype html>
<html lang={lang} dir={dir} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Sayed Mohammad Amin Emrani" />
    <meta name="theme-color" content="#09090b" />
    <meta name="color-scheme" content="dark light" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={isFa ? 'en' : 'fa'} href={alternate} />
    <link rel="alternate" hreflang="x-default" href="https://smae1993.github.io/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://smae1993.github.io/og.svg" />
    <meta property="og:locale" content={isFa ? 'fa_IR' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://smae1993.github.io/og.svg" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
  </head>
  <body>
    <a class="skip-link" href="#main">{isFa ? 'رفتن به محتوای اصلی' : 'Skip to content'}</a>
    <div class="noise" aria-hidden="true"></div>
    <div class="ambient ambient-one" aria-hidden="true"></div>
    <div class="ambient ambient-two" aria-hidden="true"></div>
    <slot />
  </body>
</html>
